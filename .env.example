# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dataqguard
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/dataqguard

# Redis
REDIS_URL=redis://localhost:6379/0

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dataqguard

# JWT
SECRET_KEY=change-this-to-a-random-secret-key

# Default Admin (only used on first run)
DEFAULT_ADMIN_EMAIL=admin@dataqguard.com
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend
VITE_API_URL=http://localhost:8000
